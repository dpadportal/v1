{
  "name": "sdo-ne",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/wrangler/bin/wrangler.js dev",
    "deploy": "node node_modules/wrangler/bin/wrangler.js deploy",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:test": "node node_modules/typescript/bin/tsc --noEmit -p test/tsconfig.json",
    "test": "node node_modules/vitest/vitest.mjs run",
    "db:init": "node node_modules/wrangler/bin/wrangler.js d1 execute arta-db --local --file=./schema.sql",
    "db:init:remote": "node node_modules/wrangler/bin/wrangler.js d1 execute arta-db --remote --file=./schema.sql",
    "seed:schools": "node scripts/seed-schools.mjs",
    "cf-typegen": "node node_modules/wrangler/bin/wrangler.js types --env-interface Env"
  },
  "dependencies": {
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260804.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  }
}

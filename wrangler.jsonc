{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arta-submission-form",
  "compatibility_date": "2026-08-06",
  "main": "src/index.ts",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arta-db",
      "database_id": "fe003d09-e275-456b-8192-8820cd66a4a5"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "4086211bd69647538634017773007730"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "dpac-portal-files"
    }
  ],
  "vars": {
    "EMAIL_FROM": "dpad portal <dpadportal@gmail.com>"
  },
  "triggers": {
    "crons": ["0 3 * * SUN"]
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arta-submission-form",
  "compatibility_date": "2026-08-06",
  "main": "src/index.ts",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arta-db",
      "database_id": "8dc992be-05bc-462e-8a4c-0b555374269f"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "f34a5c6722254b9c93db3e4584daa3d4"
    }
  ],
  "vars": {
    "EMAIL_FROM": "DPAC Portal <dpacportal@gmail.com>"
  },
  "triggers": {
    "crons": ["0 3 * * SUN"]
  }
}

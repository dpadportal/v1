{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arta-submission-form",
  "compatibility_date": "2026-08-06",
  "main": "src/index.ts",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arta-db",
      "database_id": "048727ae-ed62-4234-b7c9-18da11a4ae3a"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "984e6eb1031b450ca39b271da4026dbb"
    }
  ],
  "vars": {
    "EMAIL_FROM": "ARTA Desk <no-reply@example.com>"
  }
}
